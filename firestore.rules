rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Gallery templates ──────────────────────────────────────────
    match /gallery_templates/{docId} {
      allow read: if true;
      allow create: if request.auth != null
                    && !request.auth.token.firebase.sign_in_provider.matches('anonymous');
      allow update, delete: if request.auth != null
                            && request.auth.uid == resource.data.authorId;

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
                      && !request.auth.token.firebase.sign_in_provider.matches('anonymous');
        allow delete: if request.auth != null
                      && request.auth.uid == resource.data.authorId;
      }
    }

    // ── Users ──────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        // 本人: 全フィールド更新可
        request.auth.uid == userId ||
        // 他ユーザー: followerCount の増減のみ許可（フォロー操作）
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['followerCount'])
      );
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Following subcollection — 自分のものだけ読み書き可
      match /following/{targetId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Followers subcollection — 誰でも読み取り可、フォロー操作時に書き込み
      match /followers/{followerId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == followerId;
      }

      // Liked subcollection — 本人のみ読み書き可
      match /liked/{templateId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
