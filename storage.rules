rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ギャラリーサムネイル: ログイン済みユーザーが書き込み、全員が読み取り可能
    match /gallery_thumbnails/{docId} {
      allow read: if true;
      allow write: if request.auth != null
                   && !request.auth.token.firebase.sign_in_provider.matches('anonymous')
                   && request.resource.size < 5 * 1024 * 1024  // 5MB 上限
                   && request.resource.contentType.matches('image/.*');
    }

    // ユーザーアバター: 本人のみ書き込み、全員が読み取り可能
    match /user_avatars/{uid} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 1 * 1024 * 1024  // 1MB 上限
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
